<div class="task_table">
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Status</th>
        <th>Priority</th>
      </tr>
    </thead>
    <tbody>
      <%@task.each do |t|%>
        <tr>
          <td><%= t.id %></td>
          <td><%= t.tittle %></td>
          <td><%= t.status %></td>
          <td><%= t.priority %></td>
        </tr>
      <%end%>
    </table>
  </div>