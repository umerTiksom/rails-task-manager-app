<h1>Task list<h1/>
  <%= render partial:"task" %>
  <br>
  <h1>Task with depending status</h1>
  <%@task.each do |t|%>
    <% if t.status == "pending" %>
      <p><%= t.tittle%></p>
      <p><%=t.status%></p>
    <% elsif t.status == "completed" %>
      <p><%= t.tittle%></p>
      <p><%=t.status%></p>
    <% end %>
  <%end%>