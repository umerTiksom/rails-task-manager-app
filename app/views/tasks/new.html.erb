<%= form_with model: @task do |form|%>
  <div class="demo">
    <%= form.label :tittle, "Tittle" %>
    <%= form.text_area :tittle%>
  </div>
  <div class="demo">
    <%= form.label :status, "Status" %>
    <%= form.text_area :status %>
  </div>
  <div class="demo2">
    <%= form.label  :priority %>
    <div>
    <%= form.radio_button :priority, "high" %>
    <%= form.label :priority_high, "high" %>
    </div>
    <div>
      <%= form.radio_button :priority, "medium" %>
    <%= form.label :priority_medium, "medium" %>
    </div>
    <div>
      <%= form.radio_button :priority, "low" %>
    <%= form.label :priority_low, "Low" %>
    </div>
  </div>
  <%= form.submit %>
<% end %>